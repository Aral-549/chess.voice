# ============================================================
# VoiceChessmate — environment
#
# Copy to .env.local and fill in. Only ASSEMBLYAI_API_KEY and DEVICE_SECRET are
# required to play; without Supabase the app runs anonymously and skips saving,
# which is a supported mode, not a broken one.
#
# Full walkthrough: docs/SETUP.md
# ============================================================

# --- Required ------------------------------------------------------------

# AssemblyAI Voice Agent API key. Server-side only — never exposed to the browser.
# https://www.assemblyai.com/dashboard/signup
ASSEMBLYAI_API_KEY=your_api_key_here

# Signs the anonymous device cookie. Without it the cookie is forgeable and the
# anonymous voice budget means nothing, so the token route refuses to start.
# Generate one:  openssl rand -base64 32
DEVICE_SECRET=generate_me_see_comment_above

# --- Optional: accounts, saved games, durable quota -----------------------
# Leave blank to run anonymous-only. Set all three to enable sign-in, game
# resume, ratings, and the database-backed voice budget.
# Supabase project settings → API.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. Bypasses row level security — server-side ONLY.
# Never prefix this with NEXT_PUBLIC_, and never commit it.
SUPABASE_SERVICE_ROLE_KEY=
